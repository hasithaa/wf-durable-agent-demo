# Demo defaults; build.sh copies this to .env (git-ignored, so a token pasted there stays local).
PORTAL_PORT=9095
PORTAL_PUBLIC_URL=http://localhost:9095
# What the browser uses to reach Thunder; must match Thunder's issuer.
THUNDER_PUBLIC_URL=https://localhost:8090
SERVICE_API_KEY=tenant-app-service-key
WEBHOOK_SECRET=tenant-app-webhook-secret
# 48 agent hours = 2 minutes.
DEMO_SECONDS_PER_HOUR=2.5
# The agent's model, chosen by build.sh: scripted (offline, deterministic), ollama (local model in Docker)
# or wso2 (WSO2 AI token below). COMPOSE_PROFILES=ollama starts the Ollama container.
MODEL_PROVIDER=scripted
OLLAMA_MODEL=qwen2.5:7b
COMPOSE_PROFILES=
# Leave empty for the scripted model. With a WSO2 AI token (VS Code: default model provider, ~1 h expiry),
# the agent reasons with a real LLM: docker compose up -d integration
WSO2_AI_SERVICE_URL=
WSO2_AI_TOKEN=
